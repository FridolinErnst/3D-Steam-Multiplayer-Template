# C# style for this project. Rider, Visual Studio and VS Code (C# Dev Kit) read this file and show hints as you type.
# Everything is a "suggestion" (a hint, never a build error). The written rules are in AGENTS.md section 4.7.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,asmdef,asmref,inputactions,uss,uxml,yml,yaml}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_style = space
indent_size = 4

# ---- Layout
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_keywords_in_control_flow_statements = true
csharp_preserve_single_line_statements = true
csharp_preserve_single_line_blocks = true
dotnet_sort_system_directives_first = true

# ---- Language preferences (all suggestions)
csharp_style_namespace_declarations = block_scoped:suggestion          # Unity-friendly; matches the existing code
csharp_prefer_braces = when_multiline:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
dotnet_style_qualification_for_field = false:suggestion               # no "this._health"
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion  # int, not Int32
dotnet_style_readonly_field = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion  # write "private"

# Unity: "== null" on UnityEngine.Object is intentional (destroyed objects); don't push "is null" or "?.".
dotnet_style_coalesce_expression = false:none
dotnet_style_null_propagation = false:none
csharp_style_conditional_delegate_call = false:none
dotnet_style_prefer_is_null_check_over_reference_equality_method = false:none

# ---- Naming
# private / internal fields: _camelCase  (e.g. [SerializeField] private IntReference _health;)
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, internal, private_protected
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# constants and static readonly: PascalCase
dotnet_naming_rule.constants_pascal.severity = suggestion
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_rule.static_readonly_pascal.severity = suggestion
dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly
dotnet_naming_rule.static_readonly_pascal.style = pascal
dotnet_naming_symbols.static_readonly.applicable_kinds = field
dotnet_naming_symbols.static_readonly.required_modifiers = static, readonly

# interfaces: IName
dotnet_naming_rule.interfaces_i.severity = suggestion
dotnet_naming_rule.interfaces_i.symbols = interfaces
dotnet_naming_rule.interfaces_i.style = prefix_i
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case

# types, methods, properties, events: PascalCase
dotnet_naming_rule.members_pascal.severity = suggestion
dotnet_naming_rule.members_pascal.symbols = members
dotnet_naming_rule.members_pascal.style = pascal
dotnet_naming_symbols.members.applicable_kinds = class, struct, enum, delegate, method, property, event
dotnet_naming_style.pascal.capitalization = pascal_case

# Unity calls these by name; don't flag them as unused
dotnet_diagnostic.IDE0051.severity = none   # unused private member (Awake, OnEnable, ...)
dotnet_diagnostic.IDE0044.severity = none   # make field readonly ([SerializeField] fields are written by Unity)
